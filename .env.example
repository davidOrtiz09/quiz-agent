# --- Database ---
DATABASE_URL="file:./prisma/dev.db"

# --- Groq (LLM) ---
# Free-tier key from https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# --- Langfuse (observability + prompt management) ---
# Optional: leave blank to run with tracing/prompt-fetch disabled (in-code prompt
# fallbacks are used automatically). Point these at Langfuse Cloud or a self-hosted
# instance (see docker-compose.langfuse.yml) — switching is a pure env change.
LANGFUSE_BASEURL=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
# When the app runs in Docker against the local docker-compose.langfuse.yml stack, it must
# reach Langfuse by service name instead of localhost. Host tools keep using LANGFUSE_BASEURL.
LANGFUSE_BASEURL_DOCKER=""
